# =============================================================================
# SETA Embalagens — Agendamento
# Variáveis de ambiente necessárias para cada plataforma de deploy
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositório.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — obrigatório em todas as plataformas
# Encontre em: https://supabase.com/dashboard/project/<seu-projeto>/settings/api
# -----------------------------------------------------------------------------

# URL pública do projeto Supabase
VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Chave anon/pública (segura para expor no frontend)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...
SUPABASE_PUBLISHABLE_KEY=eyJ...

# Chave service_role (SECRETA — apenas no servidor, nunca no frontend)
# Usada pelo supabaseAdmin (client.server.ts) para operações que bypassam RLS
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# -----------------------------------------------------------------------------
# DEPLOY TARGET — define qual preset de build usar
# Valores: cloudflare | vercel | render
# Definido automaticamente pelo render.yaml; no Vercel, configure nas env vars
# -----------------------------------------------------------------------------
DEPLOY_TARGET=cloudflare

# -----------------------------------------------------------------------------
# VERCEL — configure estas variáveis no painel:
# https://vercel.com/dashboard → seu projeto → Settings → Environment Variables
#
# Variáveis necessárias:
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   DEPLOY_TARGET=vercel
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# RENDER — configure estas variáveis no painel:
# https://dashboard.render.com → seu serviço → Environment
#
# Variáveis necessárias (já declaradas no render.yaml, preencha os valores):
#   VITE_SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_URL
#   SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY
#   DEPLOY_TARGET=render  (já definido no render.yaml)
#   PORT=10000            (já definido no render.yaml)
# -----------------------------------------------------------------------------
